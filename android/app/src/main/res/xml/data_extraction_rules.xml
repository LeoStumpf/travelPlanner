<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer from Android 12 on
     (android:dataExtractionRules). Same content as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="app_flutter/attachments/.trash/" />
        <exclude domain="external" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="app_flutter/attachments/.trash/" />
    </device-transfer>
</data-extraction-rules>
